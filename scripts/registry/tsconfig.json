{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@fontsource-utils/core": ["../../packages/core/src/index.ts"]
		},
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": ["*.ts", "../../packages/core/src"]
}
